FROM debian:bookworm-slim

LABEL image.author.name="yourname"
LABEL image.author.email="yourmail@gmail"

# Install dependencies

RUN apt-get update && apt-get install -y curl 

# Download and install Salmon

RUN curl -L https://github.com/COMBINE-lab/salmon/releases/download/v1.5.2/salmon-1.5.2_linux_x86_64.tar.gz \
    -o /tmp/salmon.tar.gz

RUN tar -xzf /tmp/salmon.tar.gz -C /usr/bin --strip-components=2 && \
    rm /tmp/salmon.tar.gz


# Set the PATH environment variable (to /usr/bin)
ENV PATH="/usr/bin:$PATH"
